{
  "name": "taxation",
  "version": "0.1.0",
  "private": true,
  "description": "国税庁通達の検索システム - embedding + ベクトル検索",
  "workspaces": [
    "apps/web",
    "packages/*",
    "worker"
  ],
  "scripts": {
    "dev": "npm run dev -w apps/web",
    "build": "npm run build -w apps/web",
    "scrape": "node packages/scraper/src/index.js",
    "embed": "node scripts/embed.js"
  },
  "engines": {
    "node": ">=18"
  }
}
